#include <windows.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/src-RDP_CnC/RDP.ico"


1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "04090000"
        BEGIN
            VALUE "FileDescription", "RDP Wrapper Configuration"
            VALUE "FileVersion", "@RDPWRAP_VERSION@"
            VALUE "InternalName", "RDP_CnC"
            VALUE "OriginalFilename", "RDP_CnC.exe"
            VALUE "ProductName", "RDP Wrapper"
            VALUE "ProductVersion", "@RDPWRAP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x0000
    END
END
